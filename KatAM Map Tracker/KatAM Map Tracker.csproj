<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>KatAMMapTracker</RootNamespace>
    <AssemblyName>KatAM Map Tracker</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>..\KirbyRandomizer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Lua\katam_tracker.lua" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
