<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>KatAM_Randomizer</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <!-- The map tracker is a separate project (KatAM Map Tracker/KatAM Map Tracker.csproj); -->
  <ItemGroup>
    <Compile Remove="KatAM Map Tracker\**" />
    <EmbeddedResource Remove="KatAM Map Tracker\**" />
    <None Remove="KatAM Map Tracker\**" />
  </ItemGroup>

</Project>